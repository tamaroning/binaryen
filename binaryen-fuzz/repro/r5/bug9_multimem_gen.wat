(module
 (import "env" "h" (func $h (param i32) (result i32)))
 (import "env" "v" (func $v))
 (memory $m0 i64 0)
 (export "m0" (memory $m0))
 (memory $m1 0)
 (export "m1" (memory $m1))
 (global $g0 (mut i32) (i32.const 0))
 (export "g0" (global $g0))
 (global $g1 (mut i32) (i32.const 0))
 (export "g1" (global $g1))
 (global $g2 (mut i64) (i64.const 0))
 (export "g2" (global $g2))
 (func $f (export "f") (param $p0 i32) (param $p1 i32) (param $p2 i64) (result i32)
  (local $l0 i32)
  (local $l1 i32)
  (local $l2 i64)
  (local $i0 i32)
  (block (local.set  $i0 (i32.const 0)) (loop $Li0 (i32.store8 $m0 offset=8 (i64.extend_i32_s (select (memory.grow $m1 (i32.const 1)) (memory.grow $m1 (i32.const 1)) (i64.ne (local.get $p2) (i64.const 8)))) (i32.const -8)) (br_if  $Li0 (i32.lt_u (local.tee $i0 (i32.add (local.get $i0) (i32.const 1))) (i32.const 2)))))
  (local.set $p1 (memory.grow $m1 (i32.const -8)))
  (global.get $g1)
 )
)

# Tracked: the campaign tools (scripts, notes, hand-written .wat) and the kept
# findings (old_findings/, repro/). Not tracked: whatever a run writes.

# Worker directories and run state
/w[cpv]*/
/bin/
/coverage.json
/feat/*/
/gcfuzz/*/
/interim/*/
/ufuzz/*/
# ...except the coverage scripts (their outputs go elsewhere)
!/ufuzz/cov/
/ufuzz/config.json
/ufuzz/final_report.txt
/ufuzz/final_stats.json
/ufuzz/triage.jsonl
/ufuzz/triage.err
pids
*.pid
*.log
__pycache__/

# effcheck: run outputs and the compiled harness
/effcheck/out*/
/effcheck/canreorder

# probe directories: generated modules and per-run work directories
/probe-*/*/
/probe-*/*.wasm
/probe-*/*.dat
